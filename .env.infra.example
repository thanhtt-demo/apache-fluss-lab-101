# Copy to .env.infra (git-ignored). S3 bucket names are globally unique: replace <your-suffix>
# with lowercase letters/digits. Keep the prefixes; iam-policy.json only allows fluss-lab-* and fluss-tfstate-*.

# Fluss remote data, Iceberg warehouse and Athena results.
LAB_BUCKET=fluss-lab-<your-suffix>

# Terraform state (created by Terragrunt on first run).
TF_STATE_BUCKET=fluss-tfstate-<your-suffix>
