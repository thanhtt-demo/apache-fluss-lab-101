# Single source of truth for every pinned version. Images omit the registry; it is prefixed in
# docker-compose.yml (REGISTRY_PREFIX / QUAY_REGISTRY_PREFIX). Jar checksums in the Dockerfiles fail the build on drift.

COMPOSE_PROJECT_NAME=flusslab

# --- CDC source ---
POSTGRES_IMAGE=library/postgres:17.10-bookworm
KAFKA_IMAGE=apache/kafka:4.3.1
# Pulled from quay.io (Debezium no longer publishes current tags on Docker Hub).
CONNECT_BASE_IMAGE=debezium/connect:3.7.0.Final
SCHEMA_REGISTRY_IMAGE=confluentinc/cp-schema-registry:8.3.2
CONFLUENT_AVRO_CONVERTER_VERSION=8.3.2
KAFKA_UI_IMAGE=kafbat/kafka-ui:v1.5.0

# --- Fluss + Flink ---
ZOOKEEPER_IMAGE=library/zookeeper:3.9.2
FLUSS_IMAGE=apache/fluss:1.0.0
FLINK_BASE_IMAGE=apache/fluss-quickstart-flink:1.20-1.0.0
FLINK_KAFKA_CONNECTOR_VERSION=3.4.0-1.20
FLINK_AVRO_CONFLUENT_VERSION=1.20.0
ICEBERG_VERSION=1.10.1
FAILSAFE_VERSION=3.3.2

# --- AWS tooling ---
AWS_CLI_IMAGE=amazon/aws-cli:2.38.1
TERRAFORM_IMAGE=hashicorp/terraform:1.14.9
TERRAGRUNT_VERSION=0.97.2
# Informational only; the actual pins live in infra/root.hcl and infra/_envcommon/s3.hcl.
AWS_PROVIDER_VERSION=6.69.1
S3_BUCKET_MODULE_VERSION=5.17.0
