# Copy to .env (git-ignored). Never commit or share it.
# Use a long-term IAM user key (AKIA...). Temporary STS keys (ASIA... + AWS_SESSION_TOKEN) break
# Fluss client token generation.
AWS_ACCESS_KEY_ID=<your-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-secret-access-key>
AWS_REGION=ap-southeast-1

# --- Host ports (optional, override only on conflict; always bound to 127.0.0.1) ---
# PG_PORT=5432
# KAFKA_UI_PORT=8080
# SCHEMA_REGISTRY_PORT=8081
# FLINK_UI_PORT=8083
# CONNECT_PORT=8084

# --- Mirrors (optional, for networks without direct Internet access; leave unset otherwise) ---
# REGISTRY_PREFIX=          # docker.io mirror, no scheme, no trailing slash
# QUAY_REGISTRY_PREFIX=     # quay.io mirror
# MAVEN_REPO=               # Maven Central mirror, no trailing slash
# CONFLUENT_MAVEN_REPO=     # packages.confluent.io/maven mirror (may equal MAVEN_REPO for a group repo)
# GITHUB_MIRROR=            # github.com mirror (Terragrunt binary, S3 module tarball)
# TF_REGISTRY_MIRROR=       # registry.terraform.io mirror speaking the registry protocol, e.g. https://<host>/<path>
